# Environment Configuration Example
# Copy this file to .env and supply actual values in your local environment.
# DO NOT COMMIT .env TO VERSION CONTROL.

PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Authentication & Security
JWT_SECRET=your_jwt_secret_min_32_chars_long
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=30d

# SMS Service Configuration (Mock or real provider e.g., Fast2SMS / MSG91)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=
DLT_TE_ID_CHECKIN=
DLT_TE_ID_CHECKOUT=

# Storage Configuration (Local or S3/Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Platform Super Admin Initial Setup
SUPER_ADMIN_EMAIL=superadmin@platform.local
SUPER_ADMIN_DEFAULT_PASSWORD=ChangeMeOnFirstLogin#2026
SUPER_ADMIN_NAME="Platform Administrator"
