datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ACADEMIC_ADMIN
  STAFF
  PARENT
  STUDENT
}

enum InstituteStatus {
  ACTIVE
  SUSPENDED
  PENDING_SETUP
}

enum StudentStatus {
  ACTIVE
  PASSED_OUT
  DISCONTINUED
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceMethod {
  MANUAL
  QR_SCAN
  VOICE_CONFIRMED
}

enum FeeFrequency {
  MONTHLY
  TERM_WISE
  ONE_TIME
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  ONLINE
}

enum MaterialType {
  PDF
  IMAGE
  AUDIO
  VOICE_NOTE
  TEXT
  DOCUMENT
  HOMEWORK
  ANNOUNCEMENT
}

enum NotificationType {
  ATTENDANCE
  ACADEMIC
  GENERAL
}

enum PushDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  NOT_CONFIGURED
}

enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  COMPLETED
  LATE
  GRADED
  RESUBMISSION_REQUESTED
}

// -------------------------------------------------------------
// CORE & MULTI-TENANCY MODELS
// -------------------------------------------------------------

model Institute {
  id           String          @id @default(uuid())
  code         String          @unique // e.g., "INST-001"
  name         String
  legalName    String?
  address      String?
  city         String?
  state        String?
  postalCode   String?
  phone        String?
  email        String?
  status       InstituteStatus @default(ACTIVE)
  logoUrl      String?
  admissionPrefix   String?         @unique // Stable abbreviation used for automatic student admission numbers
  settingsJson Json?           // Dynamic settings like timezones, SMS templates, academic terms

  // GPS Geofence & Staff Attendance Configuration
  latitude                Float?
  longitude               Float?
  geofenceRadius          Float                  @default(200) // in metres
  locationVerified        Boolean                @default(false)
  workingDays             String                 @default("MON,TUE,WED,THU,FRI,SAT")
  workStartTime           String                 @default("09:00")
  workEndTime             String                 @default("18:00")
  lateGraceMinutes        Int                    @default(15)
  gpsAccuracyThreshold    Float                  @default(50) // Max horizontal accuracy in metres
  requireCheckoutGeofence Boolean                @default(true)
  timezone                String                 @default("Asia/Kolkata")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  memberships       InstituteMembership[]
  staffProfiles     StaffProfile[]
  students          Student[]
  admissionSequences AdmissionSequence[]
  subjects          Subject[]
  batches           Batch[]
  attendanceEvents  AttendanceEvent[]
  learningMaterials LearningMaterial[]
  examinations      Examination[]
  progressFeedbacks ProgressFeedback[]
  parentReviews     ParentReview[]
  conversations     Conversation[]
  feeStructures     FeeStructure[]
  payments          Payment[]
  paymentAdjustments PaymentAdjustment[]
  auditLogs         AuditLog[]
  smsNotifications  SmsNotification[]
  staffDocuments      StaffDocument[]
  notifications       Notification[]
  inAppNotifications  InAppNotification[]
  onlinePaymentOrders OnlinePaymentOrder[]
  staffAttendanceSessions StaffAttendanceSession[]

  @@index([status])
  @@index([name])
}

model User {
  id                 String    @id @default(uuid())
  email              String?   @unique
  phone              String?   @unique
  passwordHash       String
  role               UserRole
  fullName           String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships         InstituteMembership[]
  staffProfile        StaffProfile?
  parentProfile       ParentProfile?
  studentProfile      Student?
  markedAttendances   AttendanceEvent[]     @relation("MarkedByStaff")
  uploadedMaterials   LearningMaterial[]    @relation("UploadedByStaff")
  enteredMarks        ExamMark[]            @relation("EvaluatedByStaff")
  feedbacksGiven      ProgressFeedback[]    @relation("StaffFeedback")
  reviewsReceived     ParentReview[]        @relation("StaffReviews")
  gradedSubmissions   HomeworkSubmission[]  @relation("GradedByStaff")
  conversationMembers ConversationMember[]
  sentMessages        Message[]
  receivedPayments    Payment[]             @relation("RecordedByStaff")
  authorizedAdjusts   PaymentAdjustment[]   @relation("AuthorizedByStaff")
  passwordResetTokens PasswordResetToken[]
  createdStudents     Student[]             @relation("StudentCreator")
  notifications       Notification[]
  devicePushTokens    DevicePushToken[]
  auditLogs           AuditLog[]
  inAppNotifications  InAppNotification[]
  correctedStaffAttendances StaffAttendanceSession[] @relation("StaffAttendanceCorrector")

  @@index([role])
  @@index([email])
  @@index([phone])
}

model InstituteMembership {
  id          String   @id @default(uuid())
  instituteId String
  userId      String
  role        UserRole
  isActive    Boolean  @default(true)
  joinedAt    DateTime @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([instituteId, userId])
  @@index([instituteId])
  @@index([userId])
}

// -------------------------------------------------------------
// PROFILES: STAFF, PARENT, STUDENT
// -------------------------------------------------------------

model StaffProfile {
  id              String   @id @default(uuid())
  instituteId     String
  userId          String   @unique
  employeeCode    String?
  designation     String?  // e.g., Senior Mathematics Teacher
  qualification   String?
  permissionsJson Json?    // Fine-grained permission flags

  // Personal Details
  dob                      DateTime?
  gender                   String?   // "Male", "Female", "Other", "Prefer not to say"
  altPhone                 String?
  personalEmail            String?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  avatarUrl                String?

  // Current Address
  currentAddressLine1      String?
  currentAddressLine2      String?
  currentCity              String?
  currentState             String?
  currentPostalCode        String?
  currentCountry           String?   @default("India")

  // Permanent Address
  permanentAddressLine1    String?
  permanentAddressLine2    String?
  permanentCity            String?
  permanentState           String?
  permanentPostalCode      String?
  permanentCountry         String?   @default("India")
  sameAsCurrentAddress     Boolean   @default(false)

  // Employment Details
  department               String?   // e.g., "Science", "Mathematics", "Humanities"
  employmentType           String?   @default("FULL_TIME") // "FULL_TIME", "PART_TIME", "CONTRACT", "VISITING"
  joiningDate              DateTime? @default(now())
  probationEndDate         DateTime?
  workLocation             String?   // Branch/Campus
  employmentNotes          String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institute       Institute               @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments     StaffBatchAssignment[]
  batchSubjects   BatchSubject[]
  qualifications  StaffQualification[]
  experiences     StaffExperience[]
  documents       StaffDocument[]
  attendanceSessions StaffAttendanceSession[]

  @@unique([instituteId, employeeCode])
  @@index([instituteId])
}

model StaffQualification {
  id             String       @id @default(uuid())
  staffProfileId String
  degree         String       // Degree / Certification name
  fieldOfStudy   String?      // Specialization / Major
  institution    String       // College / University
  yearOfPassing  Int?
  gradeOrScore   String?
  certificateUrl String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([staffProfileId])
}

model StaffExperience {
  id              String       @id @default(uuid())
  staffProfileId  String
  institutionName String       // Previous employer
  designation     String       // Previous role
  startYear       Int?
  endYear         Int?
  subjectsTaught  String?
  totalYears      Float?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  staffProfile    StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([staffProfileId])
}

model StaffDocument {
  id             String       @id @default(uuid())
  staffProfileId String
  instituteId    String
  documentType   String       // "QUALIFICATION_CERTIFICATE", "EMPLOYMENT_AGREEMENT", "IDENTITY_PROOF", "EXPERIENCE_CERTIFICATE", "OTHER"
  displayName    String
  fileUrl        String
  fileName       String
  fileSize       Int?
  mimeType       String?
  expiryDate     DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  institute      Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([staffProfileId])
  @@index([instituteId])
}

model ParentProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  occupation    String?
  address       String?
  altPhone      String?
  isPhoneVerified Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentRelations StudentParentRelation[]
  parentReviews    ParentReview[]
  smsNotifications SmsNotification[]
}

model Student {
  id              String        @id @default(uuid())
  instituteId     String
  userId          String?       @unique // Optional student login account
  admissionNumber String
  rollNumber      String?
  firstName       String
  lastName        String
  dob             DateTime?
  gender          String?       // "MALE", "FEMALE", "OTHER"
  bloodGroup      String?
  phone           String?
  status          StudentStatus @default(ACTIVE)
  admissionDate   DateTime      @default(now())
  photoUrl        String?
  createdByUserId String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  institute        Institute               @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user             User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdByUser    User?                   @relation("StudentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  parentRelations  StudentParentRelation[]
  enrollments      StudentEnrollment[]
  attendanceEvents AttendanceEvent[]
  examMarks        ExamMark[]
  progressFeedbacks ProgressFeedback[]
  parentReviews    ParentReview[]
  homeworkSubmissions HomeworkSubmission[]
  feeAssignments   StudentFeeAssignment[]
  payments         Payment[]
  smsNotifications SmsNotification[]
  notifications    Notification[]
  onlinePaymentOrders OnlinePaymentOrder[]

  @@unique([instituteId, admissionNumber])
  @@index([instituteId])
  @@index([status])
  @@index([firstName, lastName])
  @@index([createdByUserId])
}

model StudentParentRelation {
  id                String           @id @default(uuid())
  studentId         String
  parentId          String
  relation          GuardianRelation @default(GUARDIAN)
  isPrimaryContact  Boolean          @default(false)
  canReceiveSms     Boolean          @default(true)
  createdAt         DateTime         @default(now())

  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([studentId])
  @@index([parentId])
}

// -------------------------------------------------------------
// ACADEMICS: SUBJECTS, BATCHES, ENROLLMENTS
// -------------------------------------------------------------

model Subject {
  id          String   @id @default(uuid())
  instituteId String
  name        String
  code        String?  // e.g., "MATH-10"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute         Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batchSubjects     BatchSubject[]
  enrollments       StudentEnrollment[]
  learningMaterials LearningMaterial[]
  examinations      Examination[]

  @@unique([instituteId, name])
  @@index([instituteId])
}

model Batch {
  id           String    @id @default(uuid())
  instituteId  String
  name         String    // e.g., "Class 10 - Batch A (2026-27)"
  code         String?   // Batch code, unique per institute (e.g., "B-10A")
  academicYear String    // e.g., "2026-2027"
  startDate    DateTime
  endDate      DateTime?
  description  String?
  schedule     String?   // Timing / schedule e.g., "Mon-Fri 4:00 PM - 6:00 PM"
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  institute         Institute              @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batchSubjects     BatchSubject[]
  staffAssignments  StaffBatchAssignment[]
  enrollments       StudentEnrollment[]
  attendanceEvents  AttendanceEvent[]
  learningMaterials LearningMaterial[]
  examinations      Examination[]
  progressFeedbacks ProgressFeedback[]
  feeStructures     FeeStructure[]

  @@unique([instituteId, name, academicYear])
  @@index([instituteId])
  @@index([instituteId, code])
}

model BatchSubject {
  id             String        @id @default(uuid())
  batchId        String
  subjectId      String
  staffProfileId String?
  description    String?
  schedule       String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())

  batch        Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile? @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)

  @@unique([batchId, subjectId])
  @@index([batchId])
  @@index([subjectId])
}

model StaffBatchAssignment {
  id             String   @id @default(uuid())
  staffProfileId String
  batchId        String
  assignedAt     DateTime @default(now())

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  batch        Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, batchId])
}

model StudentEnrollment {
  id         String   @id @default(uuid())
  studentId  String
  batchId    String
  subjectId  String?  // Optional subject-specific enrollment
  enrolledAt DateTime @default(now())
  isActive   Boolean  @default(true)

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([studentId, batchId, subjectId])
  @@index([studentId])
  @@index([batchId])
}

// -------------------------------------------------------------
// ATTENDANCE & SMS NOTIFICATIONS
// -------------------------------------------------------------

model AttendanceEvent {
  id             String           @id @default(uuid())
  instituteId    String
  studentId      String
  batchId        String
  eventDate      DateTime         @db.Date
  eventType      AttendanceType
  eventTime      DateTime         @default(now())
  sessionNumber  Int              @default(1)
  method         AttendanceMethod @default(MANUAL)
  isLate         Boolean          @default(false)
  isCorrected    Boolean          @default(false)
  correctionNote String?
  idempotencyKey String?          @unique
  markedById     String
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  institute        Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch            Batch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  markedBy         User              @relation("MarkedByStaff", fields: [markedById], references: [id])
  smsNotifications SmsNotification[]
  notifications    Notification[]

  @@unique([studentId, eventDate, eventType, sessionNumber])
  @@index([instituteId, eventDate])
  @@index([batchId, eventDate])
  @@index([studentId, eventDate])
}

model SmsNotification {
  id                String             @id @default(uuid())
  instituteId       String
  parentId          String
  studentId         String
  attendanceEventId String?
  phoneNumber       String
  templateName      String             // e.g., "CHECK_IN_NOTIFICATION"
  messageBody       String
  provider          String             @default("mock")
  providerRef       String?
  status            NotificationStatus @default(QUEUED)
  failureReason     String?
  retryCount        Int                @default(0)
  maxRetries        Int                @default(3)
  scheduledRetryAt  DateTime?
  idempotencyKey    String?            @unique
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime           @default(now())

  institute       Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  parent          ParentProfile    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendanceEvent AttendanceEvent? @relation(fields: [attendanceEventId], references: [id], onDelete: SetNull)

  @@index([instituteId, status])
  @@index([attendanceEventId])
  @@index([scheduledRetryAt])
}

model Notification {
  id                 String             @id @default(uuid())
  instituteId        String
  userId             String
  role               UserRole
  title              String
  message            String
  type               NotificationType   @default(ATTENDANCE)
  studentId          String?
  attendanceEventId  String?
  eventType          AttendanceType?
  eventTime          DateTime?
  isRead             Boolean            @default(false)
  readAt             DateTime?
  pushStatus         PushDeliveryStatus @default(PENDING)
  pushError          String?
  link               String?
  idempotencyKey     String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  institute          Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  student            Student?           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendanceEvent    AttendanceEvent?   @relation(fields: [attendanceEventId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([instituteId, createdAt])
  @@index([attendanceEventId])
  @@index([studentId])
}

model DevicePushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String   @default("android")
  deviceInfo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -------------------------------------------------------------
// LEARNING MATERIALS & EXAMINATIONS
// -------------------------------------------------------------

model LearningMaterial {
  id          String        @id @default(uuid())
  instituteId String
  batchId     String
  subjectId   String?
  uploaderId  String
  title       String
  description String?
  content     String?
  type        MaterialType
  isPublished Boolean       @default(true)
  publishedAt DateTime?
  fileUrl     String?       // Private object storage path/key
  fileName    String?
  fileSize    Int?          // bytes
  mimeType    String?
  dueDate     DateTime?     // If homework
  maxMarks    Decimal?      @db.Decimal(5, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  institute   Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batch       Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject     Subject?      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  uploader    User          @relation("UploadedByStaff", fields: [uploaderId], references: [id])
  submissions HomeworkSubmission[]

  @@index([instituteId, batchId])
  @@index([type])
}

model Examination {
  id           String   @id @default(uuid())
  instituteId  String
  batchId      String
  subjectId    String
  title        String
  examType     String   // e.g., "Unit Test", "Term Exam", "Monthly Assessment"
  totalMarks   Decimal  @db.Decimal(5, 2)
  passingMarks Decimal  @db.Decimal(5, 2)
  examDate     DateTime  @db.Date
  academicYear String?
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  institute Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batch     Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marks     ExamMark[]

  @@index([instituteId, batchId])
}

model HomeworkSubmission {
  id           String           @id @default(uuid())
  materialId   String
  studentId    String
  status       SubmissionStatus @default(SUBMITTED)
  submittedAt  DateTime         @default(now())
  isLate       Boolean          @default(false)
  fileUrl      String?
  fileName     String?
  fileSize     Int?
  mimeType     String?
  studentNotes String?
  grade        String?
  feedback     String?
  gradedById   String?
  gradedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student  Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy User?            @relation("GradedByStaff", fields: [gradedById], references: [id])

  @@unique([materialId, studentId])
  @@index([studentId])
  @@index([materialId])
}

model ExamMark {
  id            String   @id @default(uuid())
  examId        String
  studentId     String
  marksObtained Decimal  @db.Decimal(5, 2)
  isAbsent      Boolean  @default(false)
  remarks       String?
  evaluatedById String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam        Examination @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evaluatedBy User        @relation("EvaluatedByStaff", fields: [evaluatedById], references: [id])

  @@unique([examId, studentId])
  @@index([studentId])
}

model ProgressFeedback {
  id          String   @id @default(uuid())
  instituteId String
  studentId   String
  batchId     String
  staffId     String
  termName        String   // e.g., "Quarter 1", "Midterm"
  remarks         String
  rating          Int?     // 1 to 5 scale
  strengths       String?
  improvements    String?
  recommendations String?
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch     Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  staff     User      @relation("StaffFeedback", fields: [staffId], references: [id])

  @@index([studentId])
}

model ParentReview {
  id          String   @id @default(uuid())
  instituteId String
  parentId    String
  studentId   String
  staffId     String?
  rating      Int      // 1 to 5
  reviewText  String
  replyText   String?
  status      String   @default("PUBLISHED") // "PENDING", "PUBLISHED", "ARCHIVED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  parent    ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff     User?         @relation("StaffReviews", fields: [staffId], references: [id])

  @@index([instituteId])
  @@index([studentId])
}

// -------------------------------------------------------------
// MESSAGING & COMMUNICATION
// -------------------------------------------------------------

model Conversation {
  id          String   @id @default(uuid())
  instituteId String
  title       String?  // Optional subject/title
  isGroup     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  members   ConversationMember[]
  messages  Message[]

  @@index([instituteId])
}

model ConversationMember {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  attachmentUrl  String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

// -------------------------------------------------------------
// FEES & FINANCIAL AUDIT
// -------------------------------------------------------------

model FeeStructure {
  id          String       @id @default(uuid())
  instituteId String
  batchId     String
  name        String       // e.g., "Monthly Tuition - Class 10"
  description String?
  academicYear String?
  frequency   FeeFrequency
  amount      Decimal      @db.Decimal(10, 2)
  dueDay      Int?         // Day of month (1-31)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  institute   Institute              @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batch       Batch                  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  assignments StudentFeeAssignment[]

  @@index([instituteId])
}

model StudentFeeAssignment {
  id             String        @id @default(uuid())
  studentId      String
  feeStructureId String
  termLabel      String?       // e.g., "October 2026", "Term 1"
  academicYear   String?
  baseAmount     Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  finalAmount    Decimal       @db.Decimal(10, 2)
  dueDate        DateTime      @db.Date
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure         @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  payments     Payment[]
  adjustments  PaymentAdjustment[]
  onlinePaymentOrders OnlinePaymentOrder[]

  @@unique([studentId, feeStructureId, termLabel])
  @@index([status])
  @@index([studentId])
}

model Payment {
  id                   String        @id @default(uuid())
  instituteId          String
  studentId            String
  feeAssignmentId      String
  receiptNumber        String        @unique // e.g., "REC-2026-0001"
  amountPaid           Decimal       @db.Decimal(10, 2)
  method               PaymentMethod
  transactionReference String?       // UPI Ref / Cheque No / Bank Ref
  idempotencyKey       String?       @unique
  status               String        @default("SUCCESS")
  paidAt               DateTime      @default(now())
  recordedById         String
  remarks              String?
  createdAt            DateTime      @default(now())

  institute     Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student       Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeAssignment StudentFeeAssignment @relation(fields: [feeAssignmentId], references: [id], onDelete: Cascade)
  recordedBy    User                 @relation("RecordedByStaff", fields: [recordedById], references: [id])
  adjustments   PaymentAdjustment[]

  @@index([instituteId, paidAt])
  @@index([studentId])
}

model PaymentAdjustment {
  id              String                @id @default(uuid())
  instituteId     String?
  paymentId       String?
  feeAssignmentId String?
  adjustmentType  String                // "REFUND", "DISCOUNT", "CORRECTION"
  amount          Decimal               @db.Decimal(10, 2)
  reason          String
  authorizedById  String
  createdAt       DateTime              @default(now())

  institute     Institute?            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  payment       Payment?              @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  feeAssignment StudentFeeAssignment? @relation(fields: [feeAssignmentId], references: [id], onDelete: SetNull)
  authorizedBy  User                  @relation("AuthorizedByStaff", fields: [authorizedById], references: [id])

  @@index([instituteId])
  @@index([paymentId])
  @@index([feeAssignmentId])
}

// -------------------------------------------------------------
// SECURITY, SESSIONS & AUDIT LOGGING
// -------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
}

model AuditLog {
  id          String   @id @default(uuid())
  instituteId String?
  userId      String?
  action      String   // e.g., "FEE_PAYMENT_RECORDED", "ATTENDANCE_CORRECTED", "USER_CREATED"
  entityType  String   // e.g., "Payment", "AttendanceEvent", "Student"
  entityId    String
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  institute Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([instituteId, createdAt])
  @@index([entityType, entityId])
}

// -------------------------------------------------------------
// ADMISSION SEQUENCE COUNTER (CONCURRENCY-SAFE)
// -------------------------------------------------------------

model AdmissionSequence {
  id          String   @id @default(uuid())
  instituteId String
  year        Int
  lastSerial  Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([instituteId, year])
  @@index([instituteId, year])
}

// -------------------------------------------------------------
// IN-APP NOTIFICATIONS & ONLINE PAYMENTS
// -------------------------------------------------------------

model InAppNotification {
  id          String    @id @default(uuid())
  instituteId String
  userId      String
  studentId   String?
  type        String    // e.g. "ABSENCE", "NEW_MESSAGE", "TEST_RESULT", "FEE_DUE", "FEE_PAID", "ANNOUNCEMENT"
  title       String
  message     String
  link        String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([instituteId, createdAt])
}

model OnlinePaymentOrder {
  id                   String        @id @default(uuid())
  instituteId          String
  studentId            String
  feeAssignmentId      String
  orderId              String        @unique
  amount               Decimal       @db.Decimal(10, 2)
  currency             String        @default("INR")
  status               String        @default("PENDING")
  receiptNumber        String?
  gatewayPaymentId     String?
  gatewaySignature     String?
  paymentId            String?
  idempotencyKey       String?       @unique
  metadata             Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  institute     Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student       Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeAssignment StudentFeeAssignment @relation(fields: [feeAssignmentId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([studentId])
  @@index([orderId])
  @@index([status])
}



// -------------------------------------------------------------
// STAFF ATTENDANCE & GPS GEOFENCING MODELS
// -------------------------------------------------------------

enum StaffAttendanceStatus {
  NOT_CHECKED_IN
  CHECKED_IN
  CHECKED_OUT
  LATE
  INCOMPLETE
  ABSENT
  ON_LEAVE
  MANUALLY_CORRECTED
}

enum StaffAttendanceEventType {
  CHECK_IN
  CHECK_OUT
  MANUAL_CORRECTION
  SYSTEM_FLAG
}

model StaffAttendanceSession {
  id                    String                @id @default(uuid())
  instituteId           String
  staffId               String
  attendanceDate        DateTime              @db.Date
  status                StaffAttendanceStatus @default(CHECKED_IN)
  checkInTime           DateTime?
  checkOutTime          DateTime?
  workDurationMinutes   Int                   @default(0)
  isLate                Boolean               @default(false)
  isManuallyCorrected   Boolean               @default(false)
  correctionReason      String?
  correctedById         String?
  correctedAt           DateTime?
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  institute             Institute             @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  staff                 StaffProfile          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  correctedBy           User?                 @relation("StaffAttendanceCorrector", fields: [correctedById], references: [id], onDelete: SetNull)
  events                StaffAttendanceEvent[]

  @@unique([instituteId, staffId, attendanceDate])
  @@index([instituteId, attendanceDate])
  @@index([staffId])
  @@index([status])
}

model StaffAttendanceEvent {
  id                    String                   @id @default(uuid())
  sessionId             String
  instituteId           String
  staffId               String
  eventType             StaffAttendanceEventType
  serverTimestamp       DateTime                 @default(now())
  latitude              Float?
  longitude             Float?
  accuracy              Float?
  distanceFromCenter    Float?                   // Distance in metres from institute coordinates
  isWithinGeofence      Boolean                  @default(false)
  validationOutcome     String                   // e.g., "VERIFIED_INSIDE_GEOFENCE", "REJECTED_OUTSIDE_GEOFENCE", "MANUAL_ADJUSTMENT"
  deviceInfo            String?
  remarks               String?
  idempotencyKey        String?                  @unique
  createdAt             DateTime                 @default(now())

  session               StaffAttendanceSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([staffId])
  @@index([instituteId, serverTimestamp])
}
