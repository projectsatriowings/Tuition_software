{
  "name": "tuition-management-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=@tuition/web",
    "build:server": "npm run build --workspace=server",
    "build:web": "npm run build --workspace=@tuition/web",
    "mobile:studio": "npm run studio --workspace=@tuition/mobile",
    "mobile:android": "npm run android --workspace=@tuition/mobile",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "overrides": {
    "@expo/vector-icons": "14.0.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "metro": "~0.80.8",
    "metro-config": "~0.80.8",
    "metro-resolver": "~0.80.8"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "@types/react-dom": "~18.2.25",
    "typescript": "^5.5.4"
  }
}
