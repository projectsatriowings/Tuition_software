{
  "cli": {
    "version": ">= 25.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "REACT_NATIVE_NODE_MODULES_DIR": "../../node_modules/react-native"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "REACT_NATIVE_NODE_MODULES_DIR": "../../node_modules/react-native"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
